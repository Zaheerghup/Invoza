generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                 Int           @id @default(autoincrement())
  NTN                String        @unique
  BusinessName       String
  Address            String
  Province           String
  API_Token          String
  fbrEnvironment     String        @default("Sandbox")
  fbrSandboxUrl      String?
  fbrSandboxToken    String?
  fbrProductionUrl   String?
  fbrProductionToken String?
  userId             String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  subscriptionActive Boolean       @default(true)
  subscriptionPlan   String        @default("FREE")
  invoices           Invoice[]
  itemAccounts       ItemAccount[]
  fbrReferences      FbrReferenceData[]

  @@index([userId])
}

model Customer {
  id           Int       @id @default(autoincrement())
  CustomerName String
  NTN_CNIC     String?
  Address      String?
  Province     String    @default("Punjab")
  BuyerType    String    @default("Unregistered")
  userId       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  invoices     Invoice[]

  @@index([userId])
}

model Invoice {
  id                Int           @id @default(autoincrement())
  InvoiceDate       DateTime      @default(now())
  TotalAmount       Float
  SalesTax          Float
  FBR_InvoiceNumber String?
  FBR_Status        String        @default("PENDING")
  QRCodeData        String?
  digitalSignature  String?       // Rule 150R(4)(b)
  isOffline         Boolean       @default(false) // Rule 150XC
  offlineAt         DateTime?
  userId            String
  PaymentMode       String        @default("1")
  InvoiceType       String        @default("SI")
  companyId         Int
  customerId        Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  TaxMonth          Int?
  TaxYear           Int?
  invoiceNumber     String?
  company           Company       @relation(fields: [companyId], references: [id])
  customer          Customer      @relation(fields: [customerId], references: [id])
  items             InvoiceItem[]
  logs              SystemLog[]

  @@index([userId])
  @@index([companyId])
  @@index([customerId])
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  type      String   @default("AUDIT") // AUDIT, ERROR, SYSTEM
  action    String   // CREATE, UPDATE, DELETE, SUBMIT, REJECT
  details   String?
  changes   Json?    // Store the diff of what changed
  invoiceId Int?
  userId    String
  createdAt DateTime @default(now())
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([userId])
  @@index([invoiceId])
}

model Closing {
  id            Int      @id @default(autoincrement())
  type          String   // DAY, WEEK, MONTH - Rule 150R(4)(f)
  periodDate    DateTime
  totalInvoices Int
  totalValue    Float
  totalTax      Float
  companyId     Int
  userId        String
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([companyId])
}


model InvoiceItem {
  id          Int          @id @default(autoincrement())
  ItemName    String
  HSCode      String?
  UoM         String       @default("Numbers, pieces, units")
  SaleType    String       @default("Goods at standard rate (default)")
  Quantity    Float
  Rate        Float
  TaxPct      Float        @default(18)
  TaxAmount   Float
  Discount    Float        @default(0)
  FurtherTax  Float        @default(0)
  invoiceId   Int
  accountId   Int?
  description String?
  account     ItemAccount? @relation(fields: [accountId], references: [id])
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model ItemAccount {
  id           Int           @id @default(autoincrement())
  systemCode   String
  type         String
  name         String
  description  String?
  userId       String
  companyId    Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoiceItems InvoiceItem[]
  company      Company       @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([companyId])
}

model FbrReferenceData {
  id        Int      @id @default(autoincrement())
  type      String   // PROVINCE, DOC_TYPE, UOM, HS_CODE
  code      String
  name      String
  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, code])
  @@index([companyId, type])
}
