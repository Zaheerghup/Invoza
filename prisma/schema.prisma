generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                 Int           @id @default(autoincrement())
  NTN                String        @unique
  BusinessName       String
  Address            String
  Province           String
  API_Token          String
  userId             String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  subscriptionActive Boolean       @default(true)
  subscriptionPlan   String        @default("FREE")
  invoices           Invoice[]
  itemAccounts       ItemAccount[]
}

model Customer {
  id           Int       @id @default(autoincrement())
  CustomerName String
  NTN_CNIC     String?
  Address      String?
  BuyerType    String    @default("Individual")
  userId       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  invoices     Invoice[]
}

model Invoice {
  id                Int           @id @default(autoincrement())
  InvoiceDate       DateTime      @default(now())
  TotalAmount       Float
  SalesTax          Float
  FBR_InvoiceNumber String?
  FBR_Status        String        @default("PENDING")
  QRCodeData        String?
  userId            String
  PaymentMode       String        @default("1")
  InvoiceType       String        @default("SI")
  companyId         Int
  customerId        Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  TaxMonth          Int?
  TaxYear           Int?
  invoiceNumber     String?
  company           Company       @relation(fields: [companyId], references: [id])
  customer          Customer      @relation(fields: [customerId], references: [id])
  items             InvoiceItem[]
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?
  userId    String
  createdAt DateTime @default(now())
}

model InvoiceItem {
  id          Int          @id @default(autoincrement())
  ItemName    String
  HSCode      String?
  Quantity    Float
  Rate        Float
  TaxPct      Float        @default(18)
  TaxAmount   Float
  invoiceId   Int
  accountId   Int?
  description String?
  account     ItemAccount? @relation(fields: [accountId], references: [id])
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ItemAccount {
  id           Int           @id @default(autoincrement())
  systemCode   String
  type         String
  name         String
  description  String?
  userId       String
  companyId    Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoiceItems InvoiceItem[]
  company      Company       @relation(fields: [companyId], references: [id])
}
